/-
KissData.lean: the certificates of thm:kissing-stable, generated by gen_data.py.
Every entry (n, k) is the exact dyadic rational n / 2^k denoted by a
double-precision floating-point number; tDec, e1Dec, e2Dec are the decimals of the paper,
and top, e1, e2 the doubles the branch and bound uses (checked against
them in KissDomain).
-/
structure Cert where
  d : Nat
  f : List Rat                 -- f_1, ..., f_d
  F : List (List (List Rat))   -- F_0, ..., F_d, F_k of size d - k + 1
  tDec : Rat
  top : Rat
  e1 : Rat
  e2 : Rat
  e1Dec : Rat
  e2Dec : Rat

/-- (n, k) denotes n / 2^k. -/
def dy (x : Int × Nat) : Rat := (x.1 : Rat) / (2 ^ x.2 : Nat)

