(-0.5, -0.5, 0.5)    2        ['-e1+e3', '-e1+e4']
(-0.5, 0.5, -0.5)    2        ['-e2-e3', '-e2-e4']
(-0.5, 0.5, 0.5)     2        ['-e2+e3', '-e2+e4']
(0.0, -1.0, 0.0)     1        ['-e1+e2']
(0.0, 0.0, -1.0)     1        ['-e3-e4']
