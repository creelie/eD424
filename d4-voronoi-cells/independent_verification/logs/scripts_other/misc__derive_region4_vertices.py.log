u1(theta,t) = [sqrt(2)*(sin(theta)*cos(t) + cos(theta))/2, sqrt(2)*(-sin(theta)*cos(t) + cos(theta))/2, sqrt(2)*sin(t)*sin(theta)/2, sqrt(2)*sin(t)*sin(theta)/2]

vertex on ['+e1-e2', '+e1-e3', '+e1-e4'] + u1:
    z1 = sqrt(2)*(2*sin(t)*sin(theta) - sin(theta)*cos(t) + cos(theta) + 1)/(2*(sin(t)*sin(theta) + cos(theta)))
    z2 = sqrt(2)*(-sin(theta)*cos(t) - cos(theta) + 1)/(2*(sin(t)*sin(theta) + cos(theta)))
    z3 = sqrt(2)*(-sin(theta)*cos(t) - cos(theta) + 1)/(2*(sin(t)*sin(theta) + cos(theta)))
    z4 = sqrt(2)*(-sin(theta)*cos(t) - cos(theta) + 1)/(2*(sin(t)*sin(theta) + cos(theta)))

vertex on ['+e1+e3', '+e1+e4', '+e3+e4'] + u1:
    z1 = sqrt(2)/2
    z2 = sqrt(2)*(sin(t)*sin(theta) + sin(theta)*cos(t)/2 + cos(theta)/2 - 1)/(sin(theta)*cos(t) - cos(theta))
    z3 = sqrt(2)/2
    z4 = sqrt(2)/2

vertex on ['+e2+e3', '+e2+e4', '+e3+e4'] + u1:
    z1 = sqrt(2)*(-sin(t)*sin(theta) + sin(theta)*cos(t)/2 - cos(theta)/2 + 1)/(sin(theta)*cos(t) + cos(theta))
    z2 = sqrt(2)/2
    z3 = sqrt(2)/2
    z4 = sqrt(2)/2

